<!doctype html>
<html color-mode="user">
  <head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/mvp.css" type="text/css" webc:keep />
    <link rel="stylesheet" :href="getBundleFileUrl('css')" webc:keep />

    <meta name="color-scheme" content="dark light" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description" content="Random Bugs: a blog in the world by @5long" />
    <link href="/atom.xml" type="application/atom+xml" rel="alternate" title="Random Bugs" />

    <title webc:if=title @text="title + ' - ' + RB.siteName"></title>
    <title webc:else @text="RB.siteName"></title>

  </head>

  <body>
    <main>
      <template @raw="content" webc:nokeep></template>
    </main>
    <footer>
      <nav>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/atom.xml">Atom Feed</a></li>
          <li><a href="/archive">All Posts</a></li>
          <li><a href="https://github.com/5long">Github</a></li>
        </ul>
      </nav>
    </footer>
  </body>
</html>
